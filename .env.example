# === LLM (OpenAI-compatible: OpenAI, DeepSeek, etc.) ===
OPENAI_API_KEY=sk-...
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com
OPENAI_BASE_URL=https://api.deepseek.com
# OpenAI: gpt-4o-mini | DeepSeek: deepseek-chat (or deepseek-v4-flash)
OPENAI_MODEL=deepseek-chat
# DeepSeek has no embeddings — leave as local-hash (app uses deterministic local vectors)
OPENAI_EMBEDDING_MODEL=local-hash

# === Database (Supabase Postgres + pgvector) ===
# Project Settings → Database → Connection string (URI)
# Use postgresql+psycopg:// (add +psycopg) and replace [YOUR-PASSWORD]
# Also run in SQL Editor: CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# === Alerts ===
# Slack incoming webhook (preferred). If empty, alerts print to console.
SLACK_WEBHOOK_URL=
# Optional email via Resend
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@signalwatch.local
ALERT_TO_EMAIL=

# === Agent / policy ===
MAX_PAGES_PER_RUN=20
SCRAPE_TIMEOUT_SECONDS=30
SCRAPE_MAX_RETRIES=2
ALERT_SCORE_THRESHOLD=0.55
REVIEW_BAND_LOW=0.45
REVIEW_BAND_HIGH=0.55
REQUEST_DELAY_SECONDS=1.0

# === App ===
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
